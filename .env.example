# -----------------------------------------------------------------------------
# AI Study Summarizer — Environment Configuration Template
# Copy this file to .env and populate the required keys.
# -----------------------------------------------------------------------------

# NextAuth / Auth.js Configuration
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# AI Provider API Keys (At least one is required for live generation)
# Fallback: If no keys are provided, MockProvider runs automatically with benchmark data.
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""

# Database Configuration (Prisma ORM)
# Default is local SQLite. For production, you can switch to PostgreSQL or MySQL.
DATABASE_URL="file:./dev.db"

# Public App Metadata
NEXT_PUBLIC_APP_URL="http://localhost:3000"
