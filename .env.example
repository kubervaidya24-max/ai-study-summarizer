# AI Study Summarizer — Environment Configuration

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AI Study Summarizer"

# Authentication (Auth.js / NextAuth v5)
AUTH_SECRET="your-generated-32-byte-hex-secret-here"
AUTH_URL="http://localhost:3000"

# AI Providers (At least one provider required for active generation)
# Primary: Google Gemini API (Recommended: gemini-2.0-flash / gemini-1.5-pro)
GEMINI_API_KEY="your-gemini-api-key-here"

# Alternative: OpenAI API (gpt-4o / gpt-4o-mini)
OPENAI_API_KEY="your-openai-api-key-here"

# Alternative: Anthropic Claude API (claude-3-5-sonnet)
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# Alternative: Groq Cloud API (llama-3.3-70b-versatile)
GROQ_API_KEY="your-groq-api-key-here"

# AI Configuration Defaults
DEFAULT_AI_PROVIDER="gemini"
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2

# Database (Prisma ORM - SQLite for local, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Telemetry & Logging
ENABLE_TELEMETRY="true"
LOG_LEVEL="info"
